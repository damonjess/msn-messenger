<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1A2B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tvGameKind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGamePeer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#9FC4FF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvGameStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="#E6EEFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvGameScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#9FC4FF"
            android:textSize="14sp" />

        <GridLayout
            android:id="@+id/gridBoard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:columnCount="3"
            android:visibility="gone">

            <Button
                android:id="@+id/cell0"
                style="@style/GameCell" />

            <Button
                android:id="@+id/cell1"
                style="@style/GameCell" />

            <Button
                android:id="@+id/cell2"
                style="@style/GameCell" />

            <Button
                android:id="@+id/cell3"
                style="@style/GameCell" />

            <Button
                android:id="@+id/cell4"
                style="@style/GameCell" />

            <Button
                android:id="@+id/cell5"
                style="@style/GameCell" />

            <Button
                android:id="@+id/cell6"
                style="@style/GameCell" />

            <Button
                android:id="@+id/cell7"
                style="@style/GameCell" />

            <Button
                android:id="@+id/cell8"
                style="@style/GameCell" />
        </GridLayout>

        <LinearLayout
            android:id="@+id/layoutChoices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRock"
                    style="@style/GameChoice"
                    android:text="@string/game_rps_rock" />

                <Button
                    android:id="@+id/btnPaper"
                    style="@style/GameChoice"
                    android:text="@string/game_rps_paper" />

                <Button
                    android:id="@+id/btnScissors"
                    style="@style/GameChoice"
                    android:text="@string/game_rps_scissors" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvChoices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="#FFE9A8"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutInvite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btnDecline"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#C62828"
                android:text="@string/game_decline"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnAccept"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#2E7D32"
                android:text="@string/game_join"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnNextRound"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#2E7D32"
                android:text="@string/game_next_round"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnAgain"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#1565C0"
                android:text="@string/game_play_again"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnLeave"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#263238"
                android:text="@string/game_leave"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
