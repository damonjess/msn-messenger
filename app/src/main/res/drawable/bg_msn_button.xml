<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#CDE0F5"
                android:endColor="#B2CBE7"
                android:angle="270" />
            <corners android:radius="3dp" />
            <stroke
                android:width="1dp"
                android:color="#18426E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFFFFF"
                android:centerColor="#F0F5FA"
                android:endColor="#D9E6F5"
                android:angle="270" />
            <corners android:radius="3dp" />
            <stroke
                android:width="1dp"
                android:color="#2C598A" />
        </shape>
    </item>
</selector>
